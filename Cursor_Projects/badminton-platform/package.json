{
  "name": "badminton-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Badminton club management platform (working name). Step B: rating and matching engines.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @bp/web typecheck",
    "simulate": "tsx tools/simulator/src/index.ts",
    "simulate:quick": "tsx tools/simulator/src/index.ts --quick",
    "check": "pnpm typecheck && pnpm test && pnpm simulate:quick",
    "dev": "pnpm --filter @bp/web dev",
    "build": "pnpm --filter @bp/web build",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,storage-api,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "env:local": "node tools/scripts/write-env.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "supabase": "2.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "sharp",
      "@tailwindcss/oxide"
    ]
  },
  "packageManager": "pnpm@10.34.7"
}
