# Settings the app needs. For local development run `pnpm env:local`, which fills
# these in from the local Supabase stack. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOCAL_MAILBOX_URL=http://127.0.0.1:54324
SMTP_URL=smtp://127.0.0.1:54325
