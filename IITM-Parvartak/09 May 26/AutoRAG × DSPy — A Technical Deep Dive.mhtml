n class=3D"kw">import</span> <span class=3D"cls">SIMBA</span>

tp =3D <span class=3D"cls">SIMBA</span>(
    metric=3Dmetric,
    bsize=3D<span class=3D"num">32</span>,
    num_candidates=3D<span class=3D"num">6</span>,
    max_steps=3D<span class=3D"num">8</span>,
    max_demos=3D<span class=3D"num">4</span>,
    temperature_for_sampling=3D<span class=3D"num">0.2</span>,
    temperature_for_candidates=3D<span class=3D"num">0.2</span>,
