=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D -->
<section class=3D"slide" id=3D"s12">
  <span class=3D"slide-tag">DSPY =C2=B7 SIGNATURES</span>
  <h1 class=3D"slide-title">Signatures: <em>typed contracts</em> for LM cal=
ls</h1>

  <p class=3D"body">A <code>Signature</code> declares input fields, output =
fields, and a docstring instruction. DSPy uses this to construct the prompt=
 template =E2=80=94 and later, to optimize it.</p>

  <pre class=3D"code"><span class=3D"kw">import</span> dspy

<span class=3D"com"># Inline form</span>
qa =3D dspy.<span class=3D"cls">Predict</span>(<span class=3D"str">"context=
, question -&gt; answer"</span>)

<span class=3D"com"># Class form (preferred for production)</span>
<span class=3D"kw">class</span> <span class=3D"cls">RAGAnswer</span>(dspy.<=
span class=3D"cls">Signature</span>):
    <span class=3D"str">"""Answer the question using ONLY the provided cont=
ext.
    Cite passages by their bracketed index. Refuse if context is insufficie=
nt."""</span>

    context: <span class=3D"cls">list</span>[<span class=3D"cls">str</span>=
] =3D dspy.<span class=3D"fn">InputField</span>(desc=3D<span class=3D"str">=
"retrieved passages"</span>)
    question: <span class=3D"cls">str</span>     =3D dspy.<span class=3D"fn=
">InputField</span>()
    answer:   <span class=3D"cls">str</span>     =3D dspy.<span class=3D"fn=
">OutputField</span>(desc=3D<span class=3D"str">"=E2=89=A43 sentences, cite=
 as [1]"</span>)
    citations: <span class=3D"cls">list</span>[<span class=3D"cls">int</spa=
n>] =3D dspy.<span class=3D"fn">OutputField</span>(desc=3D<span class=3D"st=
r">"passage indices used"</span>)

predict_qa =3D dspy.<span class=3D"cls">ChainOfThought</span>(<span class=
=3D"cls">RAGAnswer</span>)
result =3D <span class=3D"fn">predict_qa</span>(context=3Dctx, question=3Dq=
)
<span class=3D"fn">print</span>(result.answer, result.citations, result.rea=
soning)</pre>

  <div class=3D"callout">
    The docstring becomes the <em>system instruction</em>. Field names beco=
me prompt slots. Field types control parsing. This is the entire surface ar=
ea you write =E2=80=94 DSPy generates the prompt.
  </div>
  <div class=3D"slide-num">12 / 44</div>
</section>

