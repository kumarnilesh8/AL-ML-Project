  <pre class=3D"code"><span class=3D"kw">def</span> <span class=3D"fn">fait=
hfulness_metric</span>(example, pred, trace=3D<span class=3D"kw">None</span=
>):
    <span class=3D"com"># LM-as-judge: are all answer claims entailed by ct=
x?</span>
    judge =3D dspy.<span class=3D"cls">ChainOfThought</span>(<span class=3D=
"str">"context, claim -&gt; entailed:bool"</span>)
    claims =3D <span class=3D"fn">extract_claims</span>(pred.answer)
    score  =3D <span class=3D"fn">np.mean</span>([<span class=3D"fn">judge<=
/span>(context=3Dpred.ctx, claim=3Dc).entailed <span class=3D"kw">for</span=
> c <span class=3D"kw">in</span> claims])

    <span class=3D"com"># Combine with answer correctness</span>
    correct =3D <span class=3D"fn">semantic_sim</span>(pred.answer, example=
.answer) &gt; <span class=3D"num">0.75</span>
    <span class=3D"kw">return</span> <span class=3D"num">0.6</span> * score=
 + <span class=3D"num">0.4</span> * <span class=3D"cls">float</span>(correc=
t)</pre>
