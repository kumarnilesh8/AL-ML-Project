<section class=3D"slide" id=3D"s34">
  <span class=3D"slide-tag">UNIFIED STACK =C2=B7 CODE</span>
  <h1 class=3D"slide-title">A <em>complete</em> ESG RAG pipeline</h1>

  <pre class=3D"code"><span class=3D"kw">import</span> dspy
<span class=3D"kw">from</span> dspy.teleprompt <span class=3D"kw">import</s=
pan> <span class=3D"cls">MIPROv2</span>

<span class=3D"com"># 1. LMs</span>
sonnet =3D dspy.<span class=3D"cls">LM</span>(<span class=3D"str">"anthropi=
c/claude-sonnet-4-6"</span>, temperature=3D<span class=3D"num">0.0</span>)
opus   =3D dspy.<span class=3D"cls">LM</span>(<span class=3D"str">"anthropi=
c/claude-opus-4-7"</span>, temperature=3D<span class=3D"num">0.7</span>)
dspy.<span class=3D"fn">configure</span>(lm=3Dsonnet)

<span class=3D"com"># 2. Signatures</span>
<span class=3D"kw">class</span> <span class=3D"cls">RewriteQuery</span>(dsp=
y.<span class=3D"cls">Signature</span>):
    <span class=3D"str">"""Rewrite a vague ESG question into a precise retr=
ieval query."""</span>
    question: <span class=3D"cls">str</span> =3D dspy.<span class=3D"fn">In=
putField</span>()
    refined: <span class=3D"cls">str</span>  =3D dspy.<span class=3D"fn">Ou=
tputField</span>()

<span class=3D"kw">class</span> <span class=3D"cls">ESGAnswer</span>(dspy.<=
span class=3D"cls">Signature</span>):
    <span class=3D"str">"""Answer ESG questions citing only the supplied co=
ntext. Be quantitative."""</span>
    context: <span class=3D"cls">list</span>[<span class=3D"cls">str</span>=
] =3D dspy.<span class=3D"fn">InputField</span>()
    question: <span class=3D"cls">str</span>     =3D dspy.<span class=3D"fn=
">InputField</span>()
    answer:   <span class=3D"cls">str</span>     =3D dspy.<span class=3D"fn=
">OutputField</span>(desc=3D<span class=3D"str">"=E2=89=A44 sentences with =
[n] citations"</span>)

<span class=3D"com"># 3. Program</span>
<span class=3D"kw">class</span> <span class=3D"cls">ESGRag</span>(dspy.<spa=
n class=3D"cls">Module</span>):
    <span class=3D"kw">def</span> <span class=3D"fn">__init__</span>(self):
        <span class=3D"kw">super</span>().<span class=3D"fn">__init__</span=
>()
        self.rewrite  =3D dspy.<span class=3D"cls">ChainOfThought</span>(<s=
pan class=3D"cls">RewriteQuery</span>)
        self.retrieve =3D dspy.<span class=3D"cls">Retrieve</span>(k=3D<spa=
n class=3D"num">5</span>)
        self.answer   =3D dspy.<span class=3D"cls">ChainOfThought</span>(<s=
pan class=3D"cls">ESGAnswer</span>)

    <span class=3D"kw">def</span> <span class=3D"fn">forward</span>(self, q=
uestion):
        rq  =3D self.<span class=3D"fn">rewrite</span>(question=3Dquestion)=
.refined
        ctx =3D self.<span class=3D"fn">retrieve</span>(rq).passages
        out =3D self.<span class=3D"fn">answer</span>(context=3Dctx, questi=
on=3Dquestion)
        <span class=3D"kw">return</span> dspy.<span class=3D"cls">Predictio=
n</span>(answer=3Dout.answer, context=3Dctx)

<span class=3D"com"># 4. Compile with MIPROv2</span>
metric =3D <span class=3D"fn">make_composite_metric</span>(faith_w=3D<span =
class=3D"num">0.6</span>, ans_w=3D<span class=3D"num">0.4</span>)
tp =3D <span class=3D"cls">MIPROv2</span>(metric=3Dmetric, prompt_model=3Do=
pus, task_model=3Dsonnet, auto=3D<span class=3D"str">"medium"</span>)
compiled =3D tp.<span class=3D"fn">compile</span>(student=3D<span class=3D"=
cls">ESGRag</span>(), trainset=3Desg_train, valset=3Desg_val)
compiled.<span class=3D"fn">save</span>(<span class=3D"str">"esg_rag.compil=
ed.json"</span>)</pre>
