  <pre class=3D"code"><span class=3D"com"># AutoRAG retrieval + rerank stag=
e</span>
<span class=3D"kw">retrieval</span>:
  modules:
    - module_type: bm25
      bm25_tokenizer: [porter_stemmer, ko_kiwi]
    - module_type: vectordb
      vectordb: default
      embedding_model: [openai, BAAI/bge-m3, intfloat/multilingual-e5-large=
]
    - module_type: hybrid_rrf
      weight: [40, 60, 80]

<span class=3D"kw">passage_reranker</span>:
  modules:
    - module_type: pass_reranker
    - module_type: koreranker
    - module_type: upr
    - module_type: rankgpt
    - module_type: <span class=3D"cls">flag_embedding_reranker</span>
      model_name: [BAAI/bge-reranker-v2-m3]</pre>
