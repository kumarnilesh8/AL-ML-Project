=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D -->
<section class=3D"slide" id=3D"s5">
  <span class=3D"slide-tag">AUTORAG =C2=B7 INGESTION</span>
  <h1 class=3D"slide-title">Chunking is <em>retrieval geometry</em></h1>

  <p class=3D"body">A chunk $c$ is a contiguous span of tokens from a docum=
ent. The chunking function $\phi: \mathcal{D} \to \{c_1, c_2, \ldots\}$ def=
ines the unit of recall. Three regimes dominate:</p>

  <table class=3D"tech">
    <thead>
      <tr><th>Strategy</th><th>Function</th><th>Strength</th><th>Weakness</=
th></tr>
    </thead>
    <tbody>
      <tr>
        <td>Token (fixed)</td>
        <td>$\phi_\tau(d) =3D \{d[i\cdot s : i\cdot s + w]\}$</td>
        <td>Predictable, dense recall</td>
        <td>Splits sentences, boundary errors</td>
      </tr>
      <tr>
        <td>Recursive</td>
        <td>Split on $[\backslash n\backslash n, \backslash n, ".", " "]$ i=
n priority</td>
        <td>Respects structure</td>
        <td>Variance in chunk size</td>
      </tr>
      <tr>
        <td>Semantic</td>
        <td>Boundary at $\cos(e_i, e_{i+1}) &lt; \tau$</td>
        <td>Topical coherence</td>
        <td>Embedding-cost at ingest</td>
      </tr>
      <tr>
        <td>Late chunking</td>
        <td>Embed full doc =E2=86=92 pool spans</td>
        <td>Global context preserved</td>
        <td>Requires long-context encoder</td>
      </tr>
    </tbody>
  </table>

  <pre class=3D"code"><span class=3D"com"># AutoRAG YAML =E2=80=94 chunker =
search space</span>
<span class=3D"kw">chunker</span>:
  modules:
    - module_type: llama_index_chunk
      chunk_method: [Token, Sentence, SentenceWindow, Semantic_llama_index]
      chunk_size: [256, 512, 1024]
      chunk_overlap: [0, 24, 50]
      add_file_name: ko</pre>
  <div class=3D"slide-num">05 / 44</div>
</section>

